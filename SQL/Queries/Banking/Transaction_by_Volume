WITH RISK AS 

(
    SELECT 
        A.customer_id,
        A.account_id,
        C.name AS Name_1,
        A.account_type,
        C.risk_rating,
        B.location,
        TRUNCATE(SUM(A.Balance),2) AS T_MAX,
        COUNT(*) AS RISK_TXN_COUNT,

                                             DENSE_RANK() OVER(PARTITION BY B.location ORDER BY SUM(A.Balance) DESC) AS Risky_Branch_CUST_Rank
    
    FROM project.transactions AS T
                                             JOIN project.accounts AS A ON T.account_id = A.account_id
                                             JOIN project.customers AS C ON A.customer_id = C.customer_id
                                             JOIN project.branches AS B ON A.branch_id = B.branch_id

    WHERE T.amount >= 30000
    GROUP BY 
        A.customer_id, A.account_id, C.name, A.account_type, C.risk_rating, B.location
)

SELECT *
FROM RISK
WHERE Risky_Branch_CUST_Rank <= 3

;
